<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.claudecodeswitcher.app</string>
	<key>CFBundleName</key>
	<string>Claude Code Switcher</string>
	<key>CFBundleDisplayName</key>
	<string>Claude Code Switcher</string>
	<key>CFBundleExecutable</key>
	<string>ClaudeCodeSwitcher</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Menu-bar-only: no Dock icon, no Cmd-Tab entry — declarative equivalent of the runtime
	     NSApplication.shared.setActivationPolicy(.accessory) call in AppDelegate, kept as belt
	     and suspenders since this is the one that Launch Services itself respects at launch time. -->
	<key>LSUIElement</key>
	<true/>
	<!-- The magic-link callback scheme — see Client.swift's redirectToURL and
	     AppDelegate.application(_:open:). Must match the Redirect URLs allow-list entry
	     (ccswitch://auth-callback) added in the Supabase dashboard's Auth settings. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.claudecodeswitcher.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ccswitch</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
