<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.claudecodeswitcher.app</string>
	<key>CFBundleName</key>
	<string>Claude Code Switcher</string>
	<key>CFBundleDisplayName</key>
	<string>Claude Code Switcher</string>
	<key>CFBundleExecutable</key>
	<string>ClaudeCodeSwitcher</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.9.11</string>
	<key>CFBundleVersion</key>
	<string>9</string>
	<!-- Sparkle auto-update. See app/appcast.xml (served via raw.githubusercontent.com off
	     main) and Engine/UpdaterProvider.swift. SUPublicEDKey is the public half of the EdDSA
	     keypair `generate_keys` created once; the private half lives only in the release-
	     builder's login Keychain and signs each release's update .zip via `sign_update`. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/ishaanpilar/claude-code-switcher/main/app/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>nG8kovulV7GvHZw1XdNkvv37oRPKw+x8FEFfnF4wiQ0=</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Menu-bar-only: no Dock icon, no Cmd-Tab entry. Declarative equivalent of the runtime
	     NSApplication.shared.setActivationPolicy(.accessory) call in AppDelegate, kept as belt
	     and suspenders since this is the one that Launch Services itself respects at launch time. -->
	<key>LSUIElement</key>
	<true/>
	<!-- The auth callback scheme. See Client.swift's redirectToURL and
	     AppDelegate.application(_:open:). Must match the Redirect URLs allow-list entry
	     (ccswitch://auth-callback) added in the Supabase dashboard's Auth settings. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.claudecodeswitcher.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ccswitch</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
